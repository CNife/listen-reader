#!/bin/sh
set -eu

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

FAILED=0

fail() {
    printf 'pre-commit: %s\n' "$1" >&2
    FAILED=1
}

ADDED=$(git diff --cached -U0 | grep -E '^\+' || true)
if printf '%s\n' "$ADDED" | grep -Eq '^\+(<<<<<<<|>>>>>>>|=======)'; then
    fail "staged 内容包含未解决的冲突标记"
fi
if printf '%s\n' "$ADDED" | grep -Eq '^\+[^+]*sk-[A-Za-z0-9]{20,}'; then
    fail "staged 内容疑似写入了明文 API Key（sk-…）"
fi

if git diff --cached --name-only | grep -q '^app/build\.gradle\.kts$'; then
    if git show :app/build.gradle.kts | grep -q '\.nmtest'; then
        fail "app/build.gradle.kts 写死了 .nmtest；请用 ./gradlew -PappIdSuffix=.nmtest 构建隔离包"
    fi
fi

SERVICE_FILES=$(printf '%s\n' "$STAGED" | grep -E '^app/src/main/java/com/cnife/listenreader/service/.+\.kt$' || true)
if [ -n "$SERVICE_FILES" ] && command -v python3 >/dev/null 2>&1; then
    if ! printf '%s\n' "$SERVICE_FILES" | python3 -c '
import re, subprocess, sys

block = re.compile(r"/\*.*?\*/", re.S)
check = re.compile(r"\brunBlocking\b")
bad = []
for path in sys.stdin.read().split("\n"):
    path = path.strip()
    if not path:
        continue
    try:
        text = subprocess.check_output(["git", "show", ":" + path], text=True)
    except subprocess.CalledProcessError:
        continue
    text = block.sub(lambda m: "\n" * m.group(0).count("\n"), text)
    text = "\n".join(line.split("//", 1)[0] for line in text.split("\n"))
    for index, line in enumerate(text.split("\n"), start=1):
        if check.search(line):
            bad.append(f"{path}:{index}")
if bad:
    print("pre-commit: service 层禁止 runBlocking：" + ", ".join(bad), file=sys.stderr)
    sys.exit(1)
'; then
        FAILED=1
    fi
fi

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

printf '%s\n' "$STAGED" | grep -E '^(app/src/main/assets/extract/.+\.js|scripts/.+\.mjs)$' | while IFS= read -r path; do
    [ -z "$path" ] && continue
    if command -v node >/dev/null 2>&1; then
        file="$TMP_DIR/$(basename "$path")"
        git show ":$path" > "$file"
        if ! node --check "$file" >/dev/null 2>&1; then
            printf 'pre-commit: %s 语法错误（node --check 失败）\n' "$path" >&2
            exit 1
        fi
    fi
done || FAILED=1

if printf '%s\n' "$STAGED" | grep -q '^app/src/main/assets/extract/templates\.json$'; then
    if command -v python3 >/dev/null 2>&1; then
        file="$TMP_DIR/templates.json"
        git show :app/src/main/assets/extract/templates.json > "$file"
        if ! python3 -m json.tool "$file" >/dev/null 2>&1; then
            fail "templates.json 不是合法 JSON"
        fi
    fi
fi

if printf '%s\n' "$STAGED" | grep -qE '^(app/src/test/java/com/cnife/listenreader/ui/UiSnapshotTest\.kt|docs/agents/verification\.md)$'; then
    if command -v python3 >/dev/null 2>&1; then
        if ! python3 -c '
import re, subprocess, sys

def staged(path):
    try:
        return subprocess.check_output(["git", "show", ":" + path], text=True)
    except subprocess.CalledProcessError:
        return ""

tests = staged("app/src/test/java/com/cnife/listenreader/ui/UiSnapshotTest.kt")
doc = staged("docs/agents/verification.md")
generated = set(re.findall(r"captureSnapshot\(\"([\w-]+)\"", tests))
documented = {name[: -len(".png")] for name in re.findall(r"`([\w-]+\.png)`", doc)}
missing = sorted(generated - documented)
if missing:
    print(
        "pre-commit: 这些快照没登记到 docs/agents/verification.md 的表格："
        + ", ".join(missing),
        file=sys.stderr,
    )
    sys.exit(1)
'; then
            FAILED=1
        fi
    fi
fi

if [ "$FAILED" -ne 0 ]; then
    printf 'pre-commit: 已阻止本次提交，修复上述问题后重新 git add。\n' >&2
    exit 1
fi

exit 0
